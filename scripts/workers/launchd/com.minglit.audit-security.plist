<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.minglit.audit-security</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/mark/workspace/minglit/scripts/workers/audit-security-run.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>12</integer>
        <key>Minute</key><integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/claude-worker-logs/audit-security.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/claude-worker-logs/audit-security.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
        <key>HOME</key><string>/Users/mark</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>/Users/mark/workspace/minglit</string>
</dict>
</plist>
