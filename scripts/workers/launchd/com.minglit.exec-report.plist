<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.minglit.exec-report</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/mark/workspace/minglit/scripts/workers/exec-report-run.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>5</integer>
        <key>Hour</key><integer>20</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/claude-worker-logs/exec-report.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/claude-worker-logs/exec-report.err</string>
</dict>
</plist>
