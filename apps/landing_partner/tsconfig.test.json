{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "module": "Node16",
    "moduleResolution": "Node16",
    "noEmit": false,
    "outDir": ".test-build",
    "rootDir": "src",
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/lib/partner-dashboard.ts",
    "src/lib/partner-dashboard.test.ts",
    "src/test-support/web-kit-ef.ts"
  ]
}
